# Copy this file to .env.local and fill it in. Never commit .env.local.

# "Ask a Question" AI box on product pages. Without a key the box shows a
# friendly "not switched on yet" message instead of failing.
ANTHROPIC_API_KEY=
# Optional: model used for answers (default: claude-haiku-4-5-20251001)
ASK_MODEL=

# Public site URL (used for canonical links and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
